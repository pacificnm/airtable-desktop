# Copy to `.env` for local development (optional).
# Vite exposes only variables prefixed with `VITE_` to the renderer.
# @see README.md and https://vite.dev/guide/env-and-mode

# -----------------------------------------------------------------------------
# Airtable API (optional defaults — users can also save credentials in the app)
# -----------------------------------------------------------------------------

# Personal access token from https://airtable.com/create/tokens
# Scopes must match what your app needs (base data, schema, etc.).
# Stored in the app takes precedence over this env value when saved locally.
VITE_AIRTABLE_PAT=

# Default base id (from the base URL: airtable.com/appXXXXXXXX/…)
# Connection profiles in the app can override per environment (Dev / Prod).
VITE_AIRTABLE_BASE_ID=

# -----------------------------------------------------------------------------
# OAuth (optional — alternative to PAT)
# @see docs/oauth-setup.md (detailed) and Developer → Documentation → OAuth setup
# -----------------------------------------------------------------------------

# From your OAuth integration in Airtable's developer settings
VITE_AIRTABLE_OAUTH_CLIENT_ID=

# Must match a redirect URL registered on the integration exactly.
# Electron dev (recommended): npm run electron:dev → http://127.0.0.1:5173/
# Plain Vite only: npm run dev → http://localhost:5173/ (or your host:port)
VITE_AIRTABLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5173/

# Space-separated scopes granted by your integration, e.g.:
# data.records:read data.records:write schema.bases:read user.email:read
VITE_AIRTABLE_OAUTH_SCOPES=

# Confidential clients only. In Electron dev, token exchange runs in the main process;
# set this in `.env` (not committed) if your integration requires a client secret.
# Never ship secrets in a public web build.
# VITE_AIRTABLE_OAUTH_CLIENT_SECRET=

# Optional. Token endpoint override.
# - Electron: main process uses https://airtable.com/oauth2/v1/token (this var unused).
# - Browser `npm run dev`: defaults to Vite proxy /__airtable_oauth/v1/token (see vite.config.ts).
# VITE_AIRTABLE_OAUTH_TOKEN_URL=/__airtable_oauth/v1/token

# -----------------------------------------------------------------------------
# Production / debug (optional)
# -----------------------------------------------------------------------------

# Leave unset for shipped builds. Set to `true` only for internal QA production builds.
# VITE_ENABLE_DEBUG_PANEL=true

# Electron main process: enable menu DevTools + debug panel when running a prod bundle.
# AIRTABLE_DEBUG=1

# -----------------------------------------------------------------------------
# Not VITE_* (used by tooling, not import.meta.env)
# -----------------------------------------------------------------------------

# Set automatically by npm run electron:dev
# VITE_DEV_SERVER_URL=http://127.0.0.1:5173
